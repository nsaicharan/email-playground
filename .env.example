# Email Configuration (SMTP)
# For Gmail: use an App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
#
# For Yahoo:
#   SMTP_HOST=smtp.mail.yahoo.com
#   SMTP_PORT=587
#
# For custom SMTP (e.g. SMTP2GO, Mailgun, SendGrid):
#   Use your provider's SMTP settings

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=your-name
EMAIL_FROM_ADDRESS=your-email@gmail.com

# Supabase Database (for sharing feature)
# Found in: Supabase Dashboard → Project → Connect → Direct → Connection string
# Use the "Transaction pooler" URL for serverless
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres